# Backend configuration. Copy to .env for local use, or set these as
# environment variables in your Railway service.

# Shared access token. When set, the dashboard and the FleetAgent endpoints
# require this token. Leave unset for local development (auth disabled).
# Generate a strong one, e.g.:  openssl rand -hex 24
FLEET_TOKEN=

# Port the backend listens on. Railway injects PORT automatically; locally it
# defaults to 3001.
# PORT=3001

# Paths to the adb / scrcpy binaries (only used by the optional local control
# path; ignored on a cloud host that has neither).
# ADB_BIN=adb
# SCRCPY_BIN=scrcpy

# Office-Room-Optimizer base URL — the dashboard pulls live meeting-room
# availability from its /api/status-all endpoint to show which rooms are free.
# Defaults to the hosted Optimizer; set empty to disable the room overview.
# OPTIMIZER_URL=https://office-room-optimizer.onrender.com
# How often (seconds) to refresh room availability (default 30).
# OPTIMIZER_POLL_SECONDS=30
