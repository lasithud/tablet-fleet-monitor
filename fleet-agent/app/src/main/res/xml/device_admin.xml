<?xml version="1.0" encoding="utf-8"?>
<!-- Device-admin policy for LockAdminReceiver. Only force-lock is needed so the
     agent can call lockNow() to lock/turn off the screen on command. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
